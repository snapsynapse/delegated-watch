{
  "name": "delegated-watch",
  "version": "0.2.1",
  "description": "A local-first, static-site record of tokens delegated to AI models, aggregated to one scrubbed row per day per source.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25 || >=26 <27"
  },
  "scripts": {
    "apply:exclusions": "node scripts/apply-source-entry-exclusions.js",
    "assemble:candidate": "node scripts/assemble-public-candidate.js",
    "build": "node scripts/build-landing.js && node scripts/build.js",
    "build:demo": "node scripts/build.js",
    "build:landing": "node scripts/build-landing.js",
    "check:runtime": "node scripts/check-runtime.js",
    "coverage": "node scripts/coverage-report.js",
    "demo:data": "node scripts/synthetic-dataset.js",
    "demo:import": "node scripts/demo-import.js",
    "dev": "node scripts/dev-server.js",
    "estimate:chatgpt": "node scripts/estimate-chatgpt.js",
    "estimate:claude-chat": "node scripts/estimate-claude-chat.js",
    "eval": "node scripts/eval-dataset.js",
    "eval:code": "node scripts/eval-code-honesty.js",
    "eval:dashboard": "node scripts/eval-dashboard.js",
    "eval:served": "node scripts/eval-served-tree.js",
    "export:csv": "node scripts/export-csv.js",
    "extract:claude-api": "node scripts/extract-claude-api.js",
    "extract:claude-code": "node scripts/extract-claude-code.js",
    "extract:codex": "node scripts/extract-codex.js",
    "extract:copilot-cli": "node scripts/extract-copilot-cli.js",
    "extract:gemini-cli": "node scripts/extract-gemini-cli.js",
    "extract:goose": "node scripts/extract-goose.js",
    "extract:openai-api": "node scripts/extract-openai-api.js",
    "extract:vscode-agents": "node scripts/extract-vscode-agents.js",
    "extract:zed-agent": "node scripts/extract-zed-agent.js",
    "import": "node scripts/import-daily-burn.js",
    "install:perplexity-hook": "node scripts/install-perplexity-hook.mjs",
    "manifest": "node scripts/build-evidence-manifest.js",
    "ollama:capture": "node scripts/ollama-capture.mjs",
    "perplexity:capture": "node scripts/perplexity-capture.mjs",
    "privacy:receipts": "node scripts/privacy-check-receipts.js",
    "reconcile:claude": "node scripts/reconcile-claude.js",
    "test": "npm run check:runtime && node --test tests/*.test.js",
    "typesafe:capture": "node scripts/typesafe-capture.mjs",
    "validate": "node scripts/validate-data.js",
    "verify:candidate": "node scripts/verify-public-candidate.js"
  }
}
